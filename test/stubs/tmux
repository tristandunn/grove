#!/usr/bin/env bash
#
# Test stub for tmux. Every call is appended to "${TMUX_STUB_DIR}/calls.log",
# one line per call, with arguments that contain whitespace (or are empty)
# wrapped in single quotes. Query answers come from fixture files in the same
# directory, which tests write with the helpers in test_helper/common.bash:
#
#   has_session          exit code for has-session (default: 1, no session)
#   sessions             one session name per line. When the file exists,
#                        has-session resolves its target the way tmux does and
#                        has_session is ignored: "=name" must match exactly,
#                        otherwise an exact name wins, and failing that a
#                        single name that starts with the target matches.
#   client_width         answer for #{client_width} (default: 120)
#   client_height        answer for #{client_height} (default: 40)
#   pane_current_path    answer for display-message -p (default: $PWD)
#   session_name         answer for #{session_name} (default: grove)
#   window_index         answer for #{window_index} (default: 0)
#   current_window       "<session> <window>" for list-panes without -a
#   panes                one pane per line, separated by tabs:
#                        <session> <window> <left> <top> <active> <id> <path>
#   pane_counter         last pane ID handed out (maintained by the stub)
#
# The text typed by send-keys is also appended to "keys.log" as
# "<target>\t<text>", without any quoting.
#
# display-popup runs its command like a popup does, in the directory of -d, and
# passes the output through. A single word is a shell command line, several
# words are a command with arguments. The environment of -e is not supported.
#
# new-session, new-window and split-window print %1, %2, %3, ... when called
# with -P.

set -euo pipefail

readonly STATE_DIR="${TMUX_STUB_DIR:?TMUX_STUB_DIR must be set}"

log_call() {
  local arg line=""

  for arg in "$@"; do
    if [[ -z "${arg}" || "${arg}" == *[[:space:]]* ]]; then
      arg="'${arg}'"
    fi

    if [[ -z "${line}" ]]; then
      line="${arg}"
    else
      line="${line} ${arg}"
    fi
  done

  printf '%s\n' "${line}" >> "${STATE_DIR}/calls.log"
}

# Set a variable to the value in a fixture file, or to the default when the file
# does not exist. Reads without a subshell, which matters because the stub runs
# for every tmux call. Usage: fixture <variable> <name> <default>
fixture() {
  local -r variable="$1"
  local -r name="$2"
  local -r default="$3"

  local fixture_value="${default}"
  if [[ -f "${STATE_DIR}/${name}" ]]; then
    IFS= read -r fixture_value < "${STATE_DIR}/${name}" || true
  fi

  printf -v "${variable}" '%s' "${fixture_value}"
}

next_pane_id() {
  local counter
  fixture counter pane_counter 0

  counter=$((counter + 1))
  printf '%s\n' "${counter}" > "${STATE_DIR}/pane_counter"
  printf '%%%s\n' "${counter}"
}

# Answer display-message -p by expanding the format variables grove asks for.
display_message() {
  local output="${last_positional}"

  local client_height client_width pane_path session_name window_index
  fixture client_width client_width 120
  fixture client_height client_height 40
  fixture pane_path pane_current_path "${PWD}"
  fixture session_name session_name grove
  fixture window_index window_index 0

  output="${output//"#{client_width}"/"${client_width}"}"
  output="${output//"#{client_height}"/"${client_height}"}"
  output="${output//"#{pane_current_path}"/"${pane_path}"}"
  output="${output//"#{session_name}"/"${session_name}"}"
  output="${output//"#{window_index}"/"${window_index}"}"

  printf '%s\n' "${output}"
}

# Render the panes fixture through the -F format. Without -a only the panes of
# the current window are listed.
list_panes() {
  local current_window
  fixture current_window current_window "grove 0"

  if [[ ! -f "${STATE_DIR}/panes" ]]; then
    return
  fi

  # Collect everything and write once, like tmux does, so a reader that exits
  # early (awk ... exit) cannot trigger SIGPIPE halfway through.
  local active id left line path result="" session top window
  while IFS=$'\t' read -r session window left top active id path; do
    if [[ -z "${session}" ]]; then
      continue
    fi

    if [[ "${all_flag}" != true && "${session} ${window}" != "${current_window}" ]]; then
      continue
    fi

    line="${format:-#\{pane_id\}}"
    line="${line//"#{session_name}"/"${session}"}"
    line="${line//"#{window_index}"/"${window}"}"
    line="${line//"#{pane_left}"/"${left}"}"
    line="${line//"#{pane_top}"/"${top}"}"
    line="${line//"#{pane_active}"/"${active}"}"
    line="${line//"#{pane_id}"/"${id}"}"
    line="${line//"#{pane_current_path}"/"${path}"}"
    result="${result}${line}"$'\n'
  done < "${STATE_DIR}/panes"

  printf '%s' "${result}"
}

# Succeed when a session target resolves to exactly one session of the sessions
# fixture, using the order tmux uses: an "=" prefix demands an exact name,
# otherwise an exact name wins and a unique name with that prefix is the
# fallback. Several names with the prefix are ambiguous, which is a failure.
session_resolves() {
  local -r wanted="$1"

  local name prefix_matches=0
  while IFS= read -r name; do
    if [[ "${wanted}" == =* ]]; then
      if [[ "${name}" == "${wanted#=}" ]]; then
        return 0
      fi
    elif [[ "${name}" == "${wanted}" ]]; then
      return 0
    elif [[ "${name}" == "${wanted}"* ]]; then
      prefix_matches=$((prefix_matches + 1))
    fi
  done < "${STATE_DIR}/sessions"

  if [[ "${prefix_matches}" -eq 1 ]]; then
    return 0
  fi

  return 1
}

# Start what display-popup would start. Flags that take a value are skipped
# together with it, except -d, which names the directory to start in.
run_popup() {
  local directory="${PWD}"

  # Like tmux, stop reading flags at the first word that is not one, so a
  # command argument that starts with a dash stays an argument.
  while [[ $# -gt 0 && "$1" == -* ]]; do
    case "$1" in
      -d)
        directory="${2:-${PWD}}"
        if [[ $# -gt 1 ]]; then
          shift
        fi
        ;;
      -b|-c|-e|-h|-s|-S|-t|-T|-w|-x|-y)
        if [[ $# -gt 1 ]]; then
          shift
        fi
        ;;
    esac

    shift
  done

  if [[ $# -eq 1 ]]; then
    (cd "${directory}" && sh -c "$1")
  elif [[ $# -gt 1 ]]; then
    (cd "${directory}" && "$@")
  fi
}

log_call "$@"

if [[ $# -eq 0 ]]; then
  echo "tmux stub: no command given" >&2
  exit 1
fi

readonly SUBCOMMAND="$1"
shift

readonly -a ORIGINAL_ARGS=("$@")

all_flag=false
format=""
last_positional=""
print_flag=false
target=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -F) format="${2:-}"; shift ;;
    -t) target="${2:-}"; shift ;;
    -P) print_flag=true ;;
    -p) print_flag=true ;;
    -a) all_flag=true ;;
    -*) ;;
    Enter) ;;  # A key name for send-keys, not text.
    *)  last_positional="$1" ;;
  esac

  if [[ $# -gt 0 ]]; then
    shift
  fi
done

case "${SUBCOMMAND}" in
  has-session)
    if [[ -f "${STATE_DIR}/sessions" ]]; then
      if session_resolves "${target}"; then
        exit 0
      fi

      exit 1
    fi

    fixture has_session_status has_session 1
    exit "${has_session_status}"
    ;;
  display-message)
    if [[ "${print_flag}" == true ]]; then
      display_message
    fi
    ;;
  list-panes)
    list_panes
    ;;
  new-session|new-window|split-window)
    if [[ "${print_flag}" == true ]]; then
      next_pane_id
    fi
    ;;
  send-keys)
    printf '%s\t%s\n' "${target}" "${last_positional}" >> "${STATE_DIR}/keys.log"
    ;;
  display-popup)
    run_popup "${ORIGINAL_ARGS[@]}"
    ;;
  select-window|select-pane|rename-window|kill-window|switch-client|attach-session)
    ;;
  *)
    echo "tmux stub: unsupported command: ${SUBCOMMAND}" >&2
    exit 1
    ;;
esac
