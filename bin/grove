#!/usr/bin/env bash
set -euo pipefail

readonly VERSION="0.2.0"

error() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -d 2000 "grove: $*"
  else
    echo "Error: $*" >&2
  fi

  exit 1
}

diff_status() {
  {
    printf '\034unstaged\n'
    git diff --numstat 2>/dev/null || true
    printf '\034staged\n'
    git diff --numstat --cached 2>/dev/null || true
    printf '\034status\n'
    git status --short
  } | awk '
    function pad(s, n,    r, i) {
      r = s; for (i = length(s); i < n; i++) r = r " "; return r
    }
    /^\034unstaged$/ { section = "u"; next }
    /^\034staged$/   { section = "s"; next }
    /^\034status$/   { section = "x"; next }
    section == "u" {
      split($0, f, "\t")
      if (f[3] != "") { ua[f[3]] = f[1]; ud[f[3]] = f[2] }
      next
    }
    section == "s" {
      split($0, f, "\t")
      if (f[3] != "") { sa[f[3]] = f[1]; sd[f[3]] = f[2] }
      next
    }
    section == "x" && (/^\?\?/ || /^.[^ ]/) { unstaged[++u] = $0; next }
    section == "x" && /^[^ ?]/              { staged[++s]   = $0 }
    END {
      max_len = 0
      for (i = 1; i <= u; i++) { fn = substr(unstaged[i],4); if (length(fn) > max_len) max_len = length(fn) }
      for (i = 1; i <= s; i++) { fn = substr(staged[i],4);   if (length(fn) > max_len) max_len = length(fn) }

      if (u > 0) printf "\033[1;2mUnstaged\033[0m\t\n"
      for (i = 1; i <= u; i++) {
        st = substr(unstaged[i],1,2); fn = substr(unstaged[i],4)
        stat = ""
        if (fn in ua && ua[fn] != "-" && ua[fn]+0 > 0) stat =             "\033[32m+" ua[fn] "\033[0m"
        if (fn in ud && ud[fn] != "-" && ud[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" ud[fn] "\033[0m"
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = "  " st "  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn
      }
      if (s > 0) printf "\033[1;2mStaged\033[0m\t\n"
      for (i = 1; i <= s; i++) {
        st = substr(staged[i],1,2); fn = substr(staged[i],4)
        stat = ""
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat =             "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = "  \033[90m" st "\033[0m  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn
      }
    }
  '
}

cmd_layout() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: grove layout <pane-id> <worktree-path>" >&2
    exit 1
  fi

  local -r pane_left="$1"
  local -r worktree_path="$2"

  local pane_diff
  pane_diff=$(tmux split-window -t "${pane_left}" -h -l '45%' -c "${worktree_path}" -P -F '#{pane_id}')
  tmux split-window -t "${pane_diff}" -v -l '50%' -c "${worktree_path}"

  local -r agent="${GROVE_AGENT:-claude}"

  sleep 0.3
  tmux send-keys -t "${pane_diff}" 'grove diff-watch' Enter
  tmux send-keys -t "${pane_left}" "${agent}" Enter
  tmux select-pane -t "${pane_left}"
}

cmd_diff_watch() {
  if [[ "${1:-}" == "--status" ]]; then
    diff_status
    exit 0
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    exit 0
  fi

  while true; do
    diff_status | fzf \
      --prompt='> ' \
      --reverse \
      --ansi \
      --info=hidden \
      --delimiter=$'\t' \
      --with-nth=1 \
      --footer=$'Enter: View  Ctrl-a: Stage  Ctrl-u: Unstage' \
      --bind "change:reload:grove diff-watch --status" \
      --bind "load:reload:sleep 2 && grove diff-watch --status" \
      --bind 'enter:transform:[[ -n {2} ]] && echo "execute(tmux display-popup -w 80% -h 80% -E '"'"'grove show-diff {2}'"'"')"' \
      --bind 'ctrl-a:transform:[[ -n {2} ]] && echo "execute-silent(git add -- {2})+reload(grove diff-watch --status)"' \
      --bind 'ctrl-u:transform:[[ -n {2} ]] && echo "execute-silent(git reset HEAD -- {2})+reload(grove diff-watch --status)"' \
      || true

    sleep 0.5
  done
}

cmd_show_diff() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: grove show-diff <file>" >&2
    exit 1
  fi

  local -r file="${1}"

  local tracked=false
  if git ls-files --error-unmatch "${file}" &>/dev/null; then
    tracked=true
  fi

  if [[ ! -e "${file}" ]] && [[ "${tracked}" == false ]]; then
    exit 0
  fi

  if [[ "${tracked}" == true ]]; then
    git diff --color=always HEAD -- "${file}" | less -R +g
  else
    git diff --color=always --no-index /dev/null "${file}" | less -R +g || true
  fi
}

cmd_new() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: grove new <task-name>" >&2
    exit 1
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    error "Not inside a git repository."
  fi

  local main_root
  main_root=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')

  local project_name
  project_name=$(basename "${main_root}")

  local worktrees_dir
  worktrees_dir="${GROVE_WORKTREES:-$(dirname "${main_root}")/worktrees}"

  local slug
  slug=$(printf '%s' "${*}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g; s/--*/-/g; s/^-//; s/-$//')

  if [[ -z "${slug}" ]]; then
    error "Task name produced an empty slug."
  fi

  local hash
  hash=$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | head -c 3)

  local -r id="${slug}-${hash}"
  local -r worktree_path="${worktrees_dir}/${id}"
  local -r branch="grove/${id}"

  git worktree add "${worktree_path}" -b "${branch}" >/dev/null

  local -r session="${project_name//[.:]/_}"

  local pane_left
  if tmux has-session -t "${session}" 2>/dev/null; then
    pane_left=$(tmux new-window -a -t "${session}" -n "${slug}" -c "${worktree_path}" -P -F '#{pane_id}')
  else
    local height width
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    height=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)

    if [[ ! "${width}" =~ ^[0-9]+$ ]]; then
      width=$(tput cols 2>/dev/null || echo 200)
    fi

    if [[ ! "${height}" =~ ^[0-9]+$ ]]; then
      height=$(tput lines 2>/dev/null || echo 48)
    fi

    pane_left=$(tmux new-session -d -s "${session}" -n "${slug}" -c "${worktree_path}" -x "${width}" -y "${height}" -P -F '#{pane_id}')
  fi

  local target_window
  target_window=$(tmux display-message -t "${pane_left}" -p '#{session_name}:#{window_index}')
  tmux select-window -t "${target_window}" 2>/dev/null || true

  cmd_layout "${pane_left}" "${worktree_path}"

  if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "${session}"
  fi
}

switch_entries() {
  local -r root_dir="${GROVE_ROOT:-${HOME}/Sites}"

  if [[ ! -d "${root_dir}" ]]; then
    error "${root_dir} does not exist."
  fi

  local current_project=""
  local git_common_dir
  git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)

  if [[ -n "${git_common_dir}" ]]; then
    if [[ "${git_common_dir}" != /* ]]; then
      git_common_dir="${PWD}/${git_common_dir}"
    fi

    local project_dir
    project_dir=$(dirname "${git_common_dir}")

    if [[ "${project_dir}" == "${root_dir}/"* ]]; then
      current_project=$(basename "${project_dir}")
    fi
  fi

  local branch project ref worktree_path
  for repo in "${root_dir}"/*/; do
    if [[ ! -e "${repo}.git" ]]; then
      continue
    fi

    project=$(basename "${repo}")
    worktree_path=""
    branch=""

    while IFS= read -r line; do
      if [[ "${line}" == worktree\ * ]]; then
        worktree_path="${line#worktree }"
      elif [[ "${line}" == branch\ * ]]; then
        ref="${line#branch }"
        branch="${ref#refs/heads/}"
      elif [[ -z "${line}" ]]; then
        if [[ -n "${branch}" && -n "${worktree_path}" && "${worktree_path}" != "${repo%/}" ]]; then
          printf '%s\t%s\t%s\n' "${project}" "${branch}" "${worktree_path}"
        fi
        worktree_path=""
        branch=""
      fi
    done < <(git -C "${repo}" worktree list --porcelain)
  done | awk -v curr="${current_project}" -F'\t' '{print ($1==curr?"0":"1") "\t" $0}' \
       | sort \
       | cut -f2- \
       | awk -F'\t' '{
    proj[NR] = $1; path[NR] = $3
    name = $3; sub(/.*\//, "", name); full[NR] = name
    slug = name; sub(/-[a-z0-9][a-z0-9][a-z0-9]$/, "", slug); short[NR] = slug
    count[$1, slug]++
  }
  END {
    for (i = 1; i <= NR; i++) {
      if (proj[i] != prev) { printf "\033[1;2m%s\033[0m\n", proj[i]; prev = proj[i] }
      display = (count[proj[i], short[i]] > 1) ? full[i] : short[i]
      printf "  %-512s%s\t%s\t%s\n", display, proj[i], proj[i], path[i]
    }
  }'
}

cmd_delete_confirm() {
  local -r worktree_path="${1:-}"

  if [[ -z "${worktree_path}" ]]; then
    return 0
  fi

  local name
  name=$(basename "${worktree_path}" | sed 's/-[a-z0-9]\{3\}$//')

  printf 'Delete "%s"? [y/N] ' "${name}" >/dev/tty
  local answer
  read -r answer </dev/tty

  if [[ "${answer}" == [yY] ]]; then
    cmd_rm --path "${worktree_path}"
  fi
}

cmd_switch() {
  if [[ "${1:-}" == "--list" ]]; then
    switch_entries
    return
  fi

  local entries_file
  entries_file=$(mktemp)
  trap 'rm -f "${entries_file:-}"' EXIT INT TERM

  switch_entries > "${entries_file}"

  if [[ ! -s "${entries_file}" ]]; then
    error "No worktrees found in ${GROVE_ROOT:-${HOME}/Sites}."
  fi

  local selected
  selected=$(fzf \
    --prompt='worktree> ' \
    --height=50% \
    --reverse \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-hscroll \
    --ellipsis '' \
    --footer=$'Enter: Open  Ctrl-d: Delete' \
    --bind 'enter:transform:[[ -n {2} ]] && echo accept' \
    --bind 'ctrl-d:execute(grove _delete-confirm {3})+reload(grove switch --list)' \
    < "${entries_file}") || exit 0

  local project worktree_path
  project=$(echo "${selected}" | cut -sf2)
  worktree_path=$(echo "${selected}" | cut -sf3)

  if [[ -z "${worktree_path}" ]]; then
    exit 0
  fi

  local window_name
  window_name=$(basename "${worktree_path}" | sed 's/-[a-z0-9]\{3\}$//')

  local -r session="${project//[.:]/_}"

  local existing_target
  existing_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null \
    | while IFS=' ' read -r win_id pane_path; do
        if [[ "${pane_path}" == "${worktree_path}" || "${pane_path}" == "${worktree_path}"/* ]]; then
          echo "${win_id}"
          break
        fi
      done) || true

  if [[ -n "${existing_target}" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "${existing_target}"
    else
      tmux attach-session -t "${existing_target}"
    fi
    exit 0
  fi

  local pane_left
  if tmux has-session -t "${session}" 2>/dev/null; then
    pane_left=$(tmux new-window -a -t "${session}" -n "${window_name}" -c "${worktree_path}" -P -F '#{pane_id}')
  else
    local height width
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    height=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)

    if [[ ! "${width}" =~ ^[0-9]+$ ]]; then
      width=$(tput cols 2>/dev/null || echo 200)
    fi

    if [[ ! "${height}" =~ ^[0-9]+$ ]]; then
      height=$(tput lines 2>/dev/null || echo 48)
    fi

    pane_left=$(tmux new-session -d -s "${session}" -n "${window_name}" -c "${worktree_path}" -x "${width}" -y "${height}" -P -F '#{pane_id}')
  fi

  local target_window
  target_window=$(tmux display-message -t "${pane_left}" -p '#{session_name}:#{window_index}')
  tmux select-window -t "${target_window}" 2>/dev/null || true

  cmd_layout "${pane_left}" "${worktree_path}"

  if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "${session}"
  fi
}

spawn_agent() {
  local -r agent_cmd="$1"

  local pane_path worktree_path
  pane_path=$(tmux display-message -p '#{pane_current_path}')
  worktree_path=$(git -C "${pane_path}" rev-parse --show-toplevel 2>/dev/null || echo "${pane_path}")

  local leftmost_pane
  leftmost_pane=$(tmux list-panes -F '#{pane_left} #{pane_active} #{pane_id}' | awk '$1==0 && $2==1{print $3; exit}')

  if [[ -z "${leftmost_pane}" ]]; then
    leftmost_pane=$(tmux list-panes -F '#{pane_left} #{pane_id}' | awk '$1==0{print $2; exit}')
  fi

  local new_pane
  new_pane=$(tmux split-window -v -t "${leftmost_pane}" -c "${worktree_path}" -P -F '#{pane_id}')

  sleep 0.3
  tmux send-keys -t "${new_pane}" "${agent_cmd}" Enter
}

cmd_add_agent() {
  spawn_agent "${GROVE_AGENT:-claude}"
}

cmd_review() {
  local prompt
  prompt=$(sed 's/^    //' <<'EOF'
    Review the current changes on this branch against the main branch.

    Look for bugs, incorrect logic, unhandled edge cases, and security
    issues. Keep the review concise and only raise issues that matter.
EOF
)

  spawn_agent "${GROVE_AGENT:-claude} $(printf '%q' "${prompt}")"
}

cmd_rm() {
  local current_worktree

  if [[ "${1:-}" == "--path" ]]; then
    if [[ -z "${2:-}" ]]; then
      error "grove rm --path requires a path argument."
    fi
    current_worktree="$2"
  else
    # run-shell inherits its cwd from the session default (the first worktree),
    # not the active window. Ask the client for the active pane's real path.
    if [[ -n "${TMUX:-}" ]]; then
      local pane_path
      pane_path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null) || true
      if [[ -n "${pane_path}" ]]; then
        cd "${pane_path}" || true
      fi
    fi

    if ! git rev-parse --git-dir &>/dev/null; then
      error "Not inside a git repository."
    fi

    current_worktree=$(git rev-parse --show-toplevel)
  fi

  local main_root
  main_root=$(git -C "${current_worktree}" worktree list --porcelain | head -1 | sed 's/^worktree //')

  if [[ "${current_worktree}" == "${main_root}" ]]; then
    error "Cannot remove the main worktree. Run this from inside a task worktree."
  fi

  local branch
  branch=$(git -C "${current_worktree}" rev-parse --abbrev-ref HEAD)

  local win_target=""
  if [[ -n "${TMUX:-}" ]]; then
    win_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null \
      | while IFS=' ' read -r win_id pane_path; do
          if [[ "${pane_path}" == "${current_worktree}" || "${pane_path}" == "${current_worktree}"/* ]]; then
            echo "${win_id}"
            break
          fi
        done) || true
  fi

  cd "${main_root}" || true
  git worktree remove "${current_worktree}" --force >/dev/null 2>&1 || true
  git branch -D "${branch}" >/dev/null 2>&1 || true

  if [[ -n "${win_target}" ]]; then
    tmux kill-window -t "${win_target}" 2>/dev/null || true
  fi
}

usage() {
  cat <<'EOF'
Usage: grove <command> [args]

Commands
  new <task-name>    Create a new worktree and tmux window.
  add-agent          Add another agent pane to the current worktree.
  review             Open a review agent pane for the current changes.
  switch             Fuzzy-pick and switch to a worktree.
  rm                 Remove the current worktree.

Environment Variables
  GROVE_AGENT        Command to run in the left pane. (default: claude)
  GROVE_ROOT         Parent directory to scan for repositories. (default: ~/Sites)
  GROVE_WORKTREES    Directory to create worktrees in. (default: <repository>/../worktrees)
EOF
}

case "${1:-}" in
  new)              shift; cmd_new "$@" ;;
  add-agent)        cmd_add_agent ;;
  review)           cmd_review ;;
  switch)           shift; cmd_switch "$@" ;;
  rm)               shift; cmd_rm "$@" ;;
  diff-watch)       shift; cmd_diff_watch "$@" ;;
  show-diff)        shift; cmd_show_diff "$@" ;;
  layout)           shift; cmd_layout "$@" ;;
  _delete-confirm)  shift; cmd_delete_confirm "$@" ;;
  -v|--version)     echo "grove version ${VERSION}" ;;
  -h|--help|help)   usage ;;
  *)
    if [[ $# -gt 1 || "${1:-}" == *" "* ]]; then
      cmd_new "$@"
    else
      usage >&2
      exit 1
    fi
    ;;
esac
