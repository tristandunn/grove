#!/usr/bin/env bash

set -euo pipefail

readonly VERSION="0.5.0"

# If in tmux display the error message, otherwise print to stderr.
error() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -d 2000 "grove: $*"
  else
    echo "Error: $*" >&2
  fi

  exit 1
}

# Build a list of changed files with colored add/remove stats for the file
# watcher. Combines unstaged changes, staged changes, and untracked files into
# one output. Each line ends with a tab-separated filename that fzf uses as a
# key for staging, unstaging, and previewing.
diff_status() {
  # Collect numstat and short status into one stream, separated by ASCII file
  # separator characters (\034) so they never conflict with filenames.
  {
    printf '\034unstaged\n'
    git diff --numstat --no-renames 2>/dev/null || true
    printf '\034staged\n'
    git diff --numstat --no-renames --cached 2>/dev/null || true
    printf '\034status\n'
    git status --short --no-renames --untracked-files=all
  } | awk '
  # The awk script merges the three sections into display lines. Unstaged files
  # show normally while staged files are dimmed. Each file gets colored add and
  # remove counts appended when the data is available.
    function pad(s, n,    r, i) {
      r = s; for (i = length(s); i < n; i++) r = r " "; return r
    }
    /^\034unstaged$/ { section = "u"; next }
    /^\034staged$/   { section = "s"; next }
    /^\034status$/   { section = "x"; next }
    section == "u" {
      split($0, f, "\t")
      if (f[3] != "") { ua[f[3]] = f[1]; ud[f[3]] = f[2] }
      next
    }
    section == "s" {
      split($0, f, "\t")
      if (f[3] != "") { sa[f[3]] = f[1]; sd[f[3]] = f[2] }
      next
    }
    section == "x" && (/^\?\?/ || /^.[^ ]/) { unstaged[++u] = $0; next }
    section == "x" && /^[^ ?]/              { staged[++s]   = $0 }
    END {
      max_len = 0
      for (i = 1; i <= u; i++) { fn = substr(unstaged[i],4); if (length(fn) > max_len) max_len = length(fn) }
      for (i = 1; i <= s; i++) { fn = substr(staged[i],4);   if (length(fn) > max_len) max_len = length(fn) }

      if (u > 0) printf "\033[1;2mUnstaged\033[0m\t\n"
      for (i = 1; i <= u; i++) {
        st = substr(unstaged[i],1,2); fn = substr(unstaged[i],4)
        stat = ""
        if (fn in ua && ua[fn] != "-" && ua[fn]+0 > 0) stat =             "\033[32m+" ua[fn] "\033[0m"
        if (fn in ud && ud[fn] != "-" && ud[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" ud[fn] "\033[0m"
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = "  " st "  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn "\tunstaged"
      }
      if (s > 0) printf "\033[1;2mStaged\033[0m\t\n"
      for (i = 1; i <= s; i++) {
        st = substr(staged[i],1,2); fn = substr(staged[i],4)
        stat = ""
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat =             "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = "  \033[90m" st "\033[0m  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn "\tstaged"
      }
    }
  '
}

# Set up the three-pane layout for a worktree window. The left pane runs the
# coding agent, the top-right pane runs the file watcher, and the bottom-right
# pane is a free shell.
cmd_layout() {
  if [[ $# -lt 2 || $# -gt 3 ]]; then
    echo "Usage: grove layout <pane-id> <worktree-path> [--continue]" >&2
    exit 1
  fi

  local -r pane_left="$1"
  local -r worktree_path="$2"
  local -r continue_flag="${3:-}"

  local pane_watcher
  pane_watcher=$(tmux split-window -t "${pane_left}" -h -l '45%' -c "${worktree_path}" -P -F '#{pane_id}')
  tmux split-window -t "${pane_watcher}" -v -l '50%' -c "${worktree_path}"

  local agent="${GROVE_AGENT:-claude}"
  if [[ "${continue_flag}" == "--continue" ]]; then
    agent="${agent} --continue"
  fi

  # Sleep so new panes have time to initialize before sending keystrokes.
  sleep 0.3
  tmux send-keys -t "${pane_watcher}" 'grove file-watch' Enter
  tmux send-keys -t "${pane_left}" "${agent}" Enter
  tmux select-pane -t "${pane_left}"
}

# Run an interactive file watcher that auto-refreshes every 2 seconds. Files
# can be staged, unstaged, or opened in a diff popup. The outer loop restarts
# fzf when it exits.
cmd_file_watch() {
  if [[ "${1:-}" == "--status" ]]; then
    diff_status
    exit 0
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    exit 0
  fi

  while true; do
    diff_status | fzf \
      --prompt='> ' \
      --reverse \
      --ansi \
      --info=hidden \
      --delimiter=$'\t' \
      --with-nth=1 \
      --footer=$'Enter: View  Ctrl-a: Stage  Ctrl-u: Unstage' \
      --bind "change:reload:grove file-watch --status" \
      --bind "load:reload:sleep 2 && grove file-watch --status" \
      --bind 'enter:transform:[[ -n {2} ]] && echo "execute(tmux display-popup -d \"\$PWD\" -w 80% -h 80% -E \"grove show-diff {2} {3}\")"' \
      --bind 'ctrl-a:execute-silent(git add -- {2})+reload(grove file-watch --status)' \
      --bind 'ctrl-u:execute-silent(git reset HEAD -- {2})+reload(grove file-watch --status)' \
      || true  # fzf returns non-zero when the list is empty.

    sleep 0.5
  done
}

# Show the difference for a single file in a pager. Staged files are diffed
# against the index, unstaged files are diffed against the working tree, and
# new files are diffed against /dev/null.
cmd_show_diff() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: grove show-diff <file> [staged|unstaged]" >&2
    exit 1
  fi

  local -r file="${1}"
  local -r section="${2:-unstaged}"

  local tracked=false
  if git ls-files --error-unmatch -- "${file}" &>/dev/null; then
    tracked=true
  fi

  if [[ ! -e "${file}" ]] && [[ "${tracked}" == false ]]; then
    exit 0
  fi

  if [[ "${section}" == "staged" ]]; then
    git diff --color=always --cached -- "${file}" | less -R +g
  elif git rev-parse --verify HEAD:"${file}" &>/dev/null; then
    git diff --color=always -- "${file}" | less -R +g
  elif [[ -e "${file}" ]]; then
    git diff --color=always --no-index -- /dev/null "${file}" | less -R +g || true
  else
    git diff --color=always -- "${file}" | less -R +g
  fi
}

# Open or create a tmux session/window for a worktree and apply the standard
# layout. Reuses an existing session when one is found; otherwise creates a new
# detached session with accurate dimensions and attaches if outside tmux.
open_worktree() {
  local -r session="$1"
  local -r window_name="$2"
  local -r working_dir="$3"
  local -r continue_flag="${4:-}"

  local pane_left
  if tmux has-session -t "${session}" 2>/dev/null; then
    pane_left=$(tmux new-window -a -t "${session}" -n "${window_name}" -c "${working_dir}" -P -F '#{pane_id}')
  else
    local height width
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    height=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)

    if [[ ! "${width}" =~ ^[0-9]+$ ]]; then
      width=$(tput cols 2>/dev/null || echo 200)
    fi

    if [[ ! "${height}" =~ ^[0-9]+$ ]]; then
      height=$(tput lines 2>/dev/null || echo 48)
    fi

    pane_left=$(tmux new-session -d -s "${session}" -n "${window_name}" -c "${working_dir}" -x "${width}" -y "${height}" -P -F '#{pane_id}')
  fi

  local target_window
  target_window=$(tmux display-message -t "${pane_left}" -p '#{session_name}:#{window_index}')
  tmux select-window -t "${target_window}" 2>/dev/null || true

  cmd_layout "${pane_left}" "${working_dir}" "${continue_flag}"

  if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "${session}"
  fi
}

# Create a new task. This sets up a git worktree, a dedicated branch, and a
# tmux window with the standard three-pane layout. The task name is slugified
# and the worktree directory and branch both take the form
# "${GROVE_PREFIX}${slug}" (default prefix: "grove/").
cmd_new() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: grove new <task-name>" >&2
    exit 1
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    error "Not inside a git repository."
  fi

  local main_root
  main_root=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')

  local project_name
  project_name=$(basename "${main_root}")

  local worktrees_dir
  worktrees_dir="${GROVE_WORKTREES:-$(dirname "${main_root}")/worktrees}"

  # Slugify the task name by lowercasing it, replacing spaces with hyphens, and
  # stripping special characters.
  local slug
  slug=$(printf '%s' "$*" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g; s/--*/-/g; s/^-//; s/-$//')

  if [[ -z "${slug}" ]]; then
    error "Task name produced an empty slug."
  fi

  local -r id="${GROVE_PREFIX-grove/}${slug}"
  local -r worktree_path="${worktrees_dir}/${id}"
  local -r branch="${id}"

  local default_branch
  default_branch=$(git -C "${main_root}" symbolic-ref --short HEAD)

  git worktree add "${worktree_path}" -b "${branch}" "${default_branch}" >/dev/null

  # The session names cannot contain dots or colons.
  local -r session="${project_name//[.:]/_}"

  open_worktree "${session}" "$(basename "${worktree_path}")" "${worktree_path}"
}

# Build the worktree list for the switcher. When invoked inside a grove-managed
# project, lists only that project's non-main worktrees. Otherwise, scans every
# repository under GROVE_ROOT.
switch_entries() {
  local -r root_dir="${GROVE_ROOT:-${HOME}/Sites}"

  if [[ ! -d "${root_dir}" ]]; then
    error "${root_dir} does not exist."
  fi

  # Resolve the current project so we can scope the list to it. The
  # git-common-dir result points at the main repository's .git even from
  # inside a worktree.
  local current_project=""
  local git_common_dir
  git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)

  if [[ -n "${git_common_dir}" ]]; then
    if [[ "${git_common_dir}" != /* ]]; then
      git_common_dir="${PWD}/${git_common_dir}"
    fi

    local project_dir
    project_dir=$(dirname "${git_common_dir}")

    if [[ "${project_dir}" == "${root_dir}/"* ]]; then
      current_project=$(basename "${project_dir}")
    fi
  fi

  local repos
  if [[ -n "${current_project}" ]]; then
    repos=("${root_dir}/${current_project}/")
  else
    repos=("${root_dir}"/*/)
  fi

  local branch project ref worktree_path
  for repo in "${repos[@]}"; do
    if [[ ! -e "${repo}.git" ]]; then
      continue
    fi

    project=$(basename "${repo}")
    worktree_path=""
    branch=""

    while IFS= read -r line; do
      if [[ "${line}" == worktree\ * ]]; then
        worktree_path="${line#worktree }"
      elif [[ "${line}" == branch\ * ]]; then
        ref="${line#branch }"
        branch="${ref#refs/heads/}"
      elif [[ -z "${line}" ]]; then
        if [[ -n "${branch}" && -n "${worktree_path}" && "${worktree_path}" != "${repo%/}" && -d "${worktree_path}" ]]; then
          printf '%s\t%s\t%s\n' "${project}" "${branch}" "${worktree_path}"
        fi
        worktree_path=""
        branch=""
      fi
    done < <(git -C "${repo}" worktree list --porcelain)
  # Format entries for fzf. Each entry displays the branch name with the
  # GROVE_PREFIX stripped; hidden tab-separated columns carry the project name
  # and path for actions.
  done | awk -v curr="${current_project}" -F'\t' '{print ($1==curr?"0":"1") "\t" $0}' \
       | sort \
       | cut -f2- \
       | awk -v prefix="${GROVE_PREFIX-grove/}" -v scoped="${current_project:+1}" -F'\t' '{
    proj[NR] = $1; path[NR] = $3
    name = $2
    if (substr(name, 1, length(prefix)) == prefix) {
      name = substr(name, length(prefix) + 1)
    }
    display[NR] = name
  }
  END {
    for (i = 1; i <= NR; i++) {
      if (!scoped && proj[i] != prev) { printf "\033[1;2m%s\033[0m\n", proj[i]; prev = proj[i] }
      printf "  %-512s%s\t%s\t%s\n", display[i], proj[i], proj[i], path[i]
    }
  }'
}

# Prompt for confirmation before deleting a worktree.
cmd_delete_confirm() {
  local -r worktree_path="${1:-}"

  if [[ -z "${worktree_path}" ]]; then
    return 0
  fi

  local name
  name=$(basename "${worktree_path}")

  printf 'Delete "%s"? [y/N] ' "${name}" >/dev/tty
  local answer
  read -r answer </dev/tty

  if [[ "${answer}" == [yY] ]]; then
    cmd_rm --path "${worktree_path}"
  fi
}

# Open the worktree switcher. If a tmux window already exists for the selected
# worktree, focus it instead of creating a duplicate. Otherwise, create a new
# window with the standard three-pane layout.
cmd_switch() {
  if [[ "${1:-}" == "--list" ]]; then
    switch_entries
    return
  fi

  local entries_file
  entries_file=$(mktemp)
  trap 'rm -f "${entries_file:-}"' EXIT INT TERM

  switch_entries > "${entries_file}"

  if [[ ! -s "${entries_file}" ]]; then
    error "No worktrees found in ${GROVE_ROOT:-${HOME}/Sites}."
  fi

  local selected
  selected=$(fzf \
    --prompt='worktree> ' \
    --height=50% \
    --reverse \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-hscroll \
    --ellipsis '' \
    --footer=$'Enter: Open  Ctrl-b: Rename  Ctrl-d: Delete' \
    --bind 'enter:transform:[[ -n {2} ]] && echo accept' \
    --bind 'ctrl-b:execute(grove _rename-prompt {3})+reload(grove switch --list)' \
    --bind 'ctrl-d:execute(grove _delete-confirm {3})+reload(grove switch --list)' \
    < "${entries_file}") || exit 0

  local project worktree_path
  project=$(echo "${selected}" | cut -sf2)
  worktree_path=$(echo "${selected}" | cut -sf3)

  if [[ -z "${worktree_path}" ]]; then
    exit 0
  fi

  local window_name
  window_name=$(basename "${worktree_path}")

  local -r session="${project//[.:]/_}"

  # Check if any tmux window already has a pane inside this worktree. Matching
  # on path prefix handles panes that have cd'd into subdirectories.
  local existing_target
  existing_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null \
    | while IFS=' ' read -r win_id pane_path; do
        if [[ "${pane_path}" == "${worktree_path}" || "${pane_path}" == "${worktree_path}"/* ]]; then
          echo "${win_id}"
          break
        fi
      done) || true

  if [[ -n "${existing_target}" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "${existing_target}"
    else
      tmux attach-session -t "${existing_target}"
    fi
    exit 0
  fi

  open_worktree "${session}" "${window_name}" "${worktree_path}" --continue
}

# Split a new vertical pane in the leftmost column and start a coding agent in
# it. The pane opens at the worktree root regardless of where the user's shell
# has navigated.
spawn_agent() {
  local -r agent_cmd="$1"

  local pane_path worktree_path
  pane_path=$(tmux display-message -p '#{pane_current_path}')
  worktree_path=$(git -C "${pane_path}" rev-parse --show-toplevel 2>/dev/null || echo "${pane_path}")

  # Prefer the active pane if it is in the leftmost column. Fall back to any
  # pane in the leftmost column so the split always lands in the right place
  # even if a different pane is focused.
  local leftmost_pane
  leftmost_pane=$(tmux list-panes -F '#{pane_left} #{pane_active} #{pane_id}' | awk '$1==0 && $2==1{print $3; exit}')

  if [[ -z "${leftmost_pane}" ]]; then
    leftmost_pane=$(tmux list-panes -F '#{pane_left} #{pane_id}' | awk '$1==0{print $2; exit}')
  fi

  local new_pane
  new_pane=$(tmux split-window -v -t "${leftmost_pane}" -c "${worktree_path}" -P -F '#{pane_id}')

  sleep 0.3
  tmux send-keys -t "${new_pane}" "${agent_cmd}" Enter
}

# Add another agent pane to the current window.
cmd_add_agent() {
  spawn_agent "${GROVE_AGENT:-claude}"
}

# Rename a worktree's branch, directory, and tmux window. Can operate on the
# current directory or on an explicit path passed with --path.
cmd_rename() {
  local current_worktree new_name

  if [[ "${1:-}" == "--path" ]]; then
    if [[ $# -lt 3 ]]; then
      echo "Usage: grove rename --path <worktree-path> <new-name>" >&2
      exit 1
    fi
    current_worktree="$2"
    shift 2
    new_name="$*"
  else
    if [[ $# -eq 0 ]]; then
      echo "Usage: grove rename <new-name>" >&2
      exit 1
    fi

    if [[ -n "${TMUX:-}" ]]; then
      local pane_path
      pane_path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null) || true
      if [[ -n "${pane_path}" ]]; then
        cd "${pane_path}" || true
      fi
    fi

    if ! git rev-parse --git-dir &>/dev/null; then
      error "Not inside a git repository."
    fi

    current_worktree=$(git rev-parse --show-toplevel)
    new_name="$*"
  fi

  local main_root
  main_root=$(git -C "${current_worktree}" worktree list --porcelain | head -1 | sed 's/^worktree //')

  if [[ "${current_worktree}" == "${main_root}" ]]; then
    error "Cannot rename the main worktree."
  fi

  local slug
  slug=$(printf '%s' "${new_name}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g; s/--*/-/g; s/^-//; s/-$//')

  if [[ -z "${slug}" ]]; then
    error "New name produced an empty slug."
  fi

  local -r new_id="${slug}"
  local -r new_branch="${new_id}"
  local -r worktrees_dir=$(dirname "${current_worktree}")
  local -r new_worktree_path="${worktrees_dir}/${new_id}"

  local old_branch
  old_branch=$(git -C "${current_worktree}" rev-parse --abbrev-ref HEAD)

  git -C "${current_worktree}" branch -m "${old_branch}" "${new_branch}"
  git worktree move "${current_worktree}" "${new_worktree_path}"

  # Rename the tmux window if one is open for this worktree.
  if [[ -n "${TMUX:-}" ]]; then
    local win_target
    win_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null \
      | while IFS=' ' read -r win_id pane_path; do
          if [[ "${pane_path}" == "${new_worktree_path}" || "${pane_path}" == "${new_worktree_path}"/* ]]; then
            echo "${win_id}"
            break
          fi
        done) || true

    if [[ -n "${win_target}" ]]; then
      tmux rename-window -t "${win_target}" "${slug}"
    fi
  fi
}

# Prompt for a new name before renaming a worktree. Used by the switcher.
cmd_rename_prompt() {
  local -r worktree_path="${1:-}"

  if [[ -z "${worktree_path}" ]]; then
    return 0
  fi

  local old_name
  old_name=$(basename "${worktree_path}")

  printf 'Rename "%s" to: ' "${old_name}" >/dev/tty
  local new_name
  read -r new_name </dev/tty

  if [[ -n "${new_name}" ]]; then
    cmd_rename --path "${worktree_path}" "${new_name}"
  fi
}

# Remove a worktree, its branch, and the tmux window that contains it. Can
# operate on the current directory or on an explicit path.
cmd_rm() {
  local current_worktree

  if [[ "${1:-}" == "--path" ]]; then
    if [[ -z "${2:-}" ]]; then
      error "grove rm --path requires a path argument."
    fi
    current_worktree="$2"
    if [[ ! -f "${current_worktree}/.git" ]]; then
      # The directory may already be gone; accept the path if git still tracks
      # it as a worktree so that stale entries can be cleaned up.
      if ! git worktree list --porcelain 2>/dev/null | grep -Fqx "worktree ${current_worktree}"; then
        error "Not a valid worktree: ${current_worktree}"
      fi
    fi
  else
    # run-shell inherits its cwd from the session default (the first worktree),
    # not the active window. Ask the client for the active pane's real path.
    if [[ -n "${TMUX:-}" ]]; then
      local pane_path
      pane_path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null) || true
      if [[ -n "${pane_path}" ]]; then
        cd "${pane_path}" || true
      fi
    fi

    if ! git rev-parse --git-dir &>/dev/null; then
      error "Not inside a git repository."
    fi

    current_worktree=$(git rev-parse --show-toplevel)
  fi

  local main_root
  main_root=$(git -C "${current_worktree}" worktree list --porcelain | head -1 | sed 's/^worktree //')

  if [[ "${current_worktree}" == "${main_root}" ]]; then
    error "Cannot remove the main worktree. Run this from inside a task worktree."
  fi

  local branch
  branch=$(git -C "${current_worktree}" rev-parse --abbrev-ref HEAD)

  # Find the tmux window whose panes point at this worktree so we can close it
  # after removing the worktree.
  local win_target=""
  if [[ -n "${TMUX:-}" ]]; then
    win_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null \
      | while IFS=' ' read -r win_id pane_path; do
          if [[ "${pane_path}" == "${current_worktree}" || "${pane_path}" == "${current_worktree}"/* ]]; then
            echo "${win_id}"
            break
          fi
        done) || true
  fi

  # Move to the main repository first before deleting the worktree.
  cd "${main_root}" || true
  git worktree remove "${current_worktree}" --force >/dev/null 2>&1 || true
  git branch -D "${branch}" >/dev/null 2>&1 || true

  if [[ -n "${win_target}" ]]; then
    tmux kill-window -t "${win_target}" 2>/dev/null || true
  fi
}

usage() {
  cat <<'EOF'
Usage: grove <command> [args]

Commands
  new <task-name>    Create a new worktree and tmux window.
  rename <new-name>  Rename the current worktree and its branch.
  add-agent          Add another agent pane to the current worktree.
  switch             Fuzzy-pick and switch to a worktree.
  rm                 Remove the current worktree.

Environment Variables
  GROVE_AGENT        Command to run in the left pane. (default: claude)
  GROVE_PREFIX       Branch and directory prefix for new worktrees. (default: grove/)
  GROVE_ROOT         Parent directory to scan for repositories. (default: ~/Sites)
  GROVE_WORKTREES    Directory to create worktrees in. (default: <repository>/../worktrees)
EOF
}

case "${1:-}" in
  new)              shift; cmd_new "$@" ;;
  rename)           shift; cmd_rename "$@" ;;
  add-agent)        cmd_add_agent ;;
  switch)           shift; cmd_switch "$@" ;;
  rm)               shift; cmd_rm "$@" ;;
  file-watch)       shift; cmd_file_watch "$@" ;;
  show-diff)        shift; cmd_show_diff "$@" ;;
  layout)           shift; cmd_layout "$@" ;;
  _rename-prompt)   shift; cmd_rename_prompt "$@" ;;
  _delete-confirm)  shift; cmd_delete_confirm "$@" ;;
  -v|--version)     echo "grove version ${VERSION}" ;;
  -h|--help|help)   usage ;;
  *)
    # Treat unrecognized multi-word arguments as a task name so users can type
    # "grove fix login bug" instead of "grove new fix login bug".
    if [[ $# -gt 1 || "${1:-}" == *" "* ]]; then
      cmd_new "$@"
    else
      usage >&2
      exit 1
    fi
    ;;
esac
