#!/usr/bin/env bash
set -euo pipefail

VERSION="0.2.0"

error() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux display-message -d 2000 "grove: $*"
  else
    echo "Error: $*" >&2
  fi

  exit 1
}

diff_status() {
  {
    printf '\034unstaged\n'
    git diff --numstat 2>/dev/null || true
    printf '\034staged\n'
    git diff --numstat --cached 2>/dev/null || true
    printf '\034status\n'
    git status --short
  } | awk '
    function pad(s, n,    r, i) {
      r = s; for (i = length(s); i < n; i++) r = r " "; return r
    }
    /^\034unstaged$/ { section = "u"; next }
    /^\034staged$/   { section = "s"; next }
    /^\034status$/   { section = "x"; next }
    section == "u" {
      split($0, f, "\t")
      if (f[3] != "") { ua[f[3]] = f[1]; ud[f[3]] = f[2] }
      next
    }
    section == "s" {
      split($0, f, "\t")
      if (f[3] != "") { sa[f[3]] = f[1]; sd[f[3]] = f[2] }
      next
    }
    section == "x" && (/^\?\?/ || /^.[^ ]/) { unstaged[++u] = $0; next }
    section == "x" && /^[^ ?]/              { staged[++s]   = $0 }
    END {
      max_len = 0
      for (i = 1; i <= u; i++) { fn = substr(unstaged[i],4); if (length(fn) > max_len) max_len = length(fn) }
      for (i = 1; i <= s; i++) { fn = substr(staged[i],4);   if (length(fn) > max_len) max_len = length(fn) }

      for (i = 1; i <= u; i++) {
        st = substr(unstaged[i],1,2); fn = substr(unstaged[i],4)
        stat = ""
        if (fn in ua && ua[fn] != "-" && ua[fn]+0 > 0) stat =             "\033[32m+" ua[fn] "\033[0m"
        if (fn in ud && ud[fn] != "-" && ud[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" ud[fn] "\033[0m"
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = st "  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn
      }
      for (i = 1; i <= s; i++) {
        st = substr(staged[i],1,2); fn = substr(staged[i],4)
        stat = ""
        if (fn in sa && sa[fn] != "-" && sa[fn]+0 > 0) stat =             "\033[32m+" sa[fn] "\033[0m"
        if (fn in sd && sd[fn] != "-" && sd[fn]+0 > 0) stat = stat (stat ? " " : "") "\033[31m-" sd[fn] "\033[0m"
        line = "\033[90m" st "\033[0m  " pad(fn, max_len)
        if (stat != "") line = line "  " stat
        print line "\t" fn
      }
    }
  '
}

cmd_layout() {
  if [[ $# -ne 2 ]]; then
    echo "Usage: grove layout <pane-id> <worktree-path>" >&2; exit 1
  fi

  local pane_left; pane_left="$1"
  local wt_path; wt_path="$2"

  local pane_diff
  pane_diff=$(tmux split-window -t "${pane_left}" -h -l '45%' -c "${wt_path}" -P -F '#{pane_id}')
  tmux split-window -t "${pane_diff}" -v -l '50%' -c "${wt_path}"

  local agent; agent="${GROVE_AGENT:-claude}"

  sleep 0.3
  tmux send-keys -t "${pane_diff}" 'grove diff-watch' Enter
  tmux send-keys -t "${pane_left}" "${agent}" Enter
  tmux select-pane -t "${pane_left}"
}

cmd_diff_watch() {
  if [[ "${1:-}" == "--status" ]]; then
    diff_status
    exit 0
  fi

  git rev-parse --git-dir &>/dev/null || exit 0

  while true; do
    diff_status | fzf \
      --prompt='> ' \
      --reverse \
      --ansi \
      --info=hidden \
      --delimiter=$'\t' \
      --with-nth=1 \
      --bind "change:reload:grove diff-watch --status" \
      --bind "load:reload:sleep 2 && grove diff-watch --status" \
      --bind "enter:execute(tmux display-popup -w 80% -h 80% -E 'grove show-diff {2}')" \
      --bind "ctrl-a:execute-silent(git add -- {2})+reload(grove diff-watch --status)" \
      --bind "ctrl-u:execute-silent(git reset HEAD -- {2})+reload(grove diff-watch --status)" \
      || true

    sleep 0.5
  done
}

cmd_show_diff() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: grove show-diff <file>" >&2; exit 1
  fi

  local -r file="${1}"

  local tracked=false
  if git ls-files --error-unmatch "${file}" &>/dev/null; then
    tracked=true
  fi

  if ! [[ -e "${file}" ]] && [[ "${tracked}" == false ]]; then
    exit 0
  fi

  if [[ "${tracked}" == true ]]; then
    git diff --color=always HEAD -- "${file}" | less -R +g
  else
    git diff --color=always --no-index /dev/null "${file}" | less -R +g || true
  fi
}

cmd_new() {
  if [[ $# -lt 1 ]]; then
    echo "Usage: grove new <task-name>" >&2; exit 1
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    error "Not inside a git repository."
  fi

  local -r main_root=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')
  local -r project_name=$(basename "${main_root}")
  local -r worktrees_dir="${GROVE_WORKTREES:-$(dirname "${main_root}")/worktrees}"

  local slug
  slug=$(printf '%s' "${*}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g; s/--*/-/g; s/^-//; s/-$//')

  if [[ -z "${slug}" ]]; then
    error "Task name produced an empty slug."
  fi

  local -r hash=$(head -c 256 /dev/urandom | LC_ALL=C tr -dc 'a-z0-9' | head -c 3)
  local -r id="${slug}-${hash}"
  local -r wt_path="${worktrees_dir}/${id}"
  local -r branch="grove/${id}"

  git worktree add "${wt_path}" -b "${branch}" >/dev/null

  local -r session="${project_name//[.:]/_}"

  local pane_left
  if tmux has-session -t "${session}" 2>/dev/null; then
    pane_left=$(tmux new-window -a -t "${session}" -n "${slug}" -c "${wt_path}" -P -F '#{pane_id}')
  else
    local width height
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    height=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)

    if [[ ! "${width}" =~ ^[0-9]+$ ]]; then
      width=$(tput cols 2>/dev/null || echo 200)
    fi

    if [[ ! "${height}" =~ ^[0-9]+$ ]]; then
      height=$(tput lines 2>/dev/null || echo 48)
    fi

    pane_left=$(tmux new-session -d -s "${session}" -n "${slug}" -c "${wt_path}" -x "${width}" -y "${height}" -P -F '#{pane_id}')
  fi

  local -r target_window=$(tmux display-message -t "${pane_left}" -p '#{session_name}:#{window_index}')
  tmux select-window -t "${target_window}" 2>/dev/null || true

  cmd_layout "${pane_left}" "${wt_path}"

  if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "${session}"
  fi
}

cmd_switch() {
  local -r root_dir="${GROVE_ROOT:-${HOME}/Sites}"

  if [[ ! -d "${root_dir}" ]]; then
    error "${root_dir} does not exist."
  fi

  local entries_file
  entries_file=$(mktemp)
  trap 'rm -f "${entries_file:-}"' EXIT INT TERM

  local current_project=""
  local git_common_dir
  git_common_dir=$(git rev-parse --git-common-dir 2>/dev/null || true)
  if [[ -n "${git_common_dir}" ]]; then
    [[ "${git_common_dir}" != /* ]] && git_common_dir="${PWD}/${git_common_dir}"
    local project_dir
    project_dir=$(dirname "${git_common_dir}")
    if [[ "${project_dir}" == "${root_dir}/"* ]]; then
      current_project=$(basename "${project_dir}")
    fi
  fi

  local local_project local_wt_path local_branch local_ref
  for repo in "${root_dir}"/*/; do
    [[ -e "${repo}.git" ]] || continue
    local_project=$(basename "${repo}")

    local_wt_path=""
    local_branch=""

    while IFS= read -r line; do
      if [[ "${line}" == worktree\ * ]]; then
        local_wt_path="${line#worktree }"
      elif [[ "${line}" == branch\ * ]]; then
        local_ref="${line#branch }"
        local_branch="${local_ref#refs/heads/}"
      elif [[ -z "${line}" ]]; then
        if [[ -n "${local_branch}" && -n "${local_wt_path}" && "${local_wt_path}" != "${repo%/}" ]]; then
          printf '%s\t%s\t%s\n' "${local_project}" "${local_branch}" "${local_wt_path}"
        fi
        local_wt_path=""
        local_branch=""
      fi
    done < <(git -C "${repo}" worktree list --porcelain)
  done | awk -v curr="${current_project}" -F'\t' '{print ($1==curr?"0":"1") "\t" $0}' \
       | sort \
       | cut -f2- \
       | awk -F'\t' '{
    proj[NR] = $1; path[NR] = $3
    name = $3; sub(/.*\//, "", name); full[NR] = name
    slug = name; sub(/-[a-z0-9][a-z0-9][a-z0-9]$/, "", slug); short[NR] = slug
    count[$1, slug]++
  }
  END {
    for (i = 1; i <= NR; i++) {
      if (proj[i] != prev) { printf "\033[1;2m%s\033[0m\n", proj[i]; prev = proj[i] }
      display = (count[proj[i], short[i]] > 1) ? full[i] : short[i]
      printf "  %-512s%s\t%s\t%s\n", display, proj[i], proj[i], path[i]
    }
  }' > "${entries_file}"

  if [[ ! -s "${entries_file}" ]]; then
    error "No worktrees found in ${root_dir}."
  fi

  local selected
  selected=$(fzf \
    --prompt='worktree> ' \
    --height=50% \
    --reverse \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=1 \
    --no-hscroll \
    --ellipsis '' \
    --bind 'enter:transform:[[ -n {2} ]] && echo accept' < "${entries_file}") || exit 0

  local -r wt_path=$(echo "${selected}" | cut -sf3)
  local -r project=$(echo "${selected}" | cut -sf2)

  if [[ -z "${wt_path}" ]]; then
    exit 0
  fi

  local -r window_name=$(basename "${wt_path}" | sed 's/-[a-z0-9]\{3\}$//')
  local -r session="${project//[.:]/_}"

  local existing_target
  existing_target=$(tmux list-panes -a -F '#{session_name}:#{window_index} #{pane_current_path}' 2>/dev/null | while IFS=' ' read -r win_target pane_path; do
    if [[ "${pane_path}" == "${wt_path}" || "${pane_path}" == "${wt_path}"/* ]]; then
      echo "${win_target}"
      break
    fi
  done) || true

  if [[ -n "${existing_target}" ]]; then
    if [[ -n "${TMUX:-}" ]]; then
      tmux switch-client -t "${existing_target}"
    else
      tmux attach-session -t "${existing_target}"
    fi
    exit 0
  fi

  local pane_left
  if tmux has-session -t "${session}" 2>/dev/null; then
    pane_left=$(tmux new-window -a -t "${session}" -n "${window_name}" -c "${wt_path}" -P -F '#{pane_id}')
  else
    local width height
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
    height=$(tmux display-message -p '#{client_height}' 2>/dev/null || true)

    if [[ ! "${width}" =~ ^[0-9]+$ ]]; then
      width=$(tput cols 2>/dev/null || echo 200)
    fi

    if [[ ! "${height}" =~ ^[0-9]+$ ]]; then
      height=$(tput lines 2>/dev/null || echo 48)
    fi

    pane_left=$(tmux new-session -d -s "${session}" -n "${window_name}" -c "${wt_path}" -x "${width}" -y "${height}" -P -F '#{pane_id}')
  fi

  local -r target_window=$(tmux display-message -t "${pane_left}" -p '#{session_name}:#{window_index}')
  tmux select-window -t "${target_window}" 2>/dev/null || true

  cmd_layout "${pane_left}" "${wt_path}"

  if [[ -z "${TMUX:-}" ]]; then
    exec tmux attach-session -t "${session}"
  fi
}

spawn_agent() {
  local cmd="$1"
  local pane_path wt_path
  pane_path=$(tmux display-message -p '#{pane_current_path}')
  wt_path=$(git -C "${pane_path}" rev-parse --show-toplevel 2>/dev/null || echo "${pane_path}")

  local pane0
  pane0=$(tmux list-panes -F '#{pane_left} #{pane_active} #{pane_id}' | awk '$1==0 && $2==1{print $3; exit}')
  [[ -z "${pane0}" ]] && pane0=$(tmux list-panes -F '#{pane_left} #{pane_id}' | awk '$1==0{print $2; exit}')

  local new_pane
  new_pane=$(tmux split-window -v -t "${pane0}" -c "${wt_path}" -P -F '#{pane_id}')

  sleep 0.3
  tmux send-keys -t "${new_pane}" "${cmd}" Enter
}

cmd_add_agent() {
  spawn_agent "${GROVE_AGENT:-claude}"
}

cmd_review() {
  local prompt
  prompt=$(sed 's/^    //' <<'EOF'
    Review the current changes on this branch against the main branch.

    Look for bugs, incorrect logic, unhandled edge cases, and security
    issues. Keep the review concise and only raise issues that matter.
EOF
)

  spawn_agent "${GROVE_AGENT:-claude} $(printf '%q' "${prompt}")"
}

cmd_rm() {
  # run-shell inherits its cwd from the session default (the first worktree),
  # not the active window. Ask the client for the active pane's real path.
  if [[ -n "${TMUX:-}" ]]; then
    local pane_path
    pane_path=$(tmux display-message -p '#{pane_current_path}' 2>/dev/null) || true
    if [[ -n "${pane_path}" ]]; then
      cd "${pane_path}" || true
    fi
  fi

  if ! git rev-parse --git-dir &>/dev/null; then
    error "Not inside a git repository."
  fi

  local -r current_wt=$(git rev-parse --show-toplevel)
  local -r main_root=$(git worktree list --porcelain | head -1 | sed 's/^worktree //')

  if [[ "${current_wt}" == "${main_root}" ]]; then
    error "Cannot remove the main worktree. Run this from inside a task worktree."
  fi

  local -r branch=$(git rev-parse --abbrev-ref HEAD)

  cd "${main_root}" || true
  git worktree remove "${current_wt}" --force >/dev/null 2>&1 || true
  git branch -D "${branch}" >/dev/null 2>&1 || true

  if [[ -n "${TMUX:-}" ]]; then
    tmux kill-window 2>/dev/null || true
  fi
}

usage() {
  cat <<'EOF'
Usage: grove <command> [args]

Commands
  new <task-name>    Create a new worktree and tmux window.
  add-agent          Add another agent pane to the current worktree.
  review             Open a review agent pane for the current changes.
  switch             Fuzzy-pick and switch to a worktree.
  rm                 Remove the current worktree.

Environment Variables
  GROVE_AGENT        Command to run in the left pane. (default: claude)
  GROVE_ROOT         Parent directory to scan for repositories. (default: ~/Sites)
  GROVE_WORKTREES    Directory to create worktrees in. (default: <repository>/../worktrees)
EOF
}

case "${1:-}" in
  new)        shift; cmd_new "$@" ;;
  add-agent)  cmd_add_agent ;;
  review)     cmd_review ;;
  switch)     cmd_switch ;;
  rm)         cmd_rm ;;
  diff-watch) shift; cmd_diff_watch "$@" ;;
  show-diff)  shift; cmd_show_diff "$@" ;;
  layout)     shift; cmd_layout "$@" ;;
  -v|--version) echo "grove version ${VERSION}" ;;
  -h|--help|help) usage ;;
  *)
    if [[ $# -gt 1 || "${1:-}" == *" "* ]]; then
      cmd_new "$@"
    else
      usage >&2
      exit 1
    fi
    ;;
esac
